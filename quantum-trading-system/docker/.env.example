# Environment Configuration for Quantum Trading System
# Copy this file to .env and fill in your API keys

# ============================================================================
# API KEYS (Required for data fetching)
# ============================================================================

# Tiingo API Key - https://www.tiingo.com/
TIINGO_API_KEY=your_tiingo_api_key_here

# Yahoo Finance API Key (optional)
YAHOO_FINANCE_API_KEY=your_yahoo_api_key_here

# FRED API Key - https://fred.stlouisfed.org/
FRED_API_KEY=your_fred_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Python path
PYTHONPATH=/app

# AgentDB configuration
AGENTDB_PATH=/app/data/agentdb/agentdb.db
AGENTDB_PORT=3000

# Cache configuration
CACHE_DIR=/app/data/cache
CACHE_TTL=3600

# ============================================================================
# DOCKER COMPOSE SETTINGS
# ============================================================================

# Project name
COMPOSE_PROJECT_NAME=quantum-trading

# Working directory
PWD=/home/user/agentic-flow/quantum-trading-system

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# CPU limits (cores)
CPU_LIMIT=2
CPU_RESERVATION=1

# Memory limits (in GB)
MEMORY_LIMIT=4G
MEMORY_RESERVATION=2G

# ============================================================================
# NETWORKING
# ============================================================================

# Jupyter port
JUPYTER_PORT=8888

# AgentDB port
AGENTDB_API_PORT=3000

# Application API port (if using)
APP_PORT=8000

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Pytest options
PYTEST_ADDOPTS=--color=yes -v

# ============================================================================
# PRODUCTION SETTINGS (for Swarm deployment)
# ============================================================================

# Swarm replicas
SWARM_REPLICAS=3

# Update parallelism
UPDATE_PARALLELISM=1

# Placement zone
NODE_ZONE=us-east-1a

# NFS server for shared volumes
NFS_SERVER=nfs-server.local
NFS_PATH=/quantum

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Enable monitoring
ENABLE_MONITORING=false

# Log format: json or text
LOG_FORMAT=json

# Sentry DSN (optional)
SENTRY_DSN=

# ============================================================================
# SECURITY
# ============================================================================

# JWT secret (for API authentication)
JWT_SECRET=your_secret_key_here

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8888,http://localhost:3000
